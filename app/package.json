{
  "name": "streamsound-app",
  "version": "0.2.0-alpha.2",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode release",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "bundle:android": "node -e \"require('fs').mkdirSync('.codex-bundle-test/assets',{recursive:true})\" && react-native bundle --platform android --dev false --entry-file index.js --bundle-output .codex-bundle-test/index.android.bundle --assets-dest .codex-bundle-test/assets --reset-cache",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-community/slider": "^5.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@shopify/flash-list": "^1.7.3",
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-native": "^0.76.6",
    "react-native-fast-image": "^8.6.3",
    "react-native-mmkv": "^3.2.0",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "^4.4.0",
    "react-native-track-player": "^4.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native/metro-config": "^0.76.6",
    "@types/react": "^18.3.18",
    "@types/react-native": "^0.73.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.7.3"
  }
}
