# Server
PORT=3000
HOST=0.0.0.0

# Music library root directory
MUSIC_ROOT=/music

# Database
DB_PATH=./data/streamsound.db

# JWT
JWT_SECRET=your-secret-key-change-this
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

# Scan
SCAN_CRON=0 * * * *
SCAN_ON_START=true

# Registration approval (true = new users need admin approval)
REQUIRE_APPROVAL=false
