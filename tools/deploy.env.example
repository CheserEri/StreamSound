# 复制为 tools/deploy.env 后填写；deploy.env 已被 gitignore
# 以下均为示例值，请替换成自己的服务器信息

STREAMSOUND_SSH_HOST=your-server-ip
STREAMSOUND_SSH_PORT=22
STREAMSOUND_SSH_USER=your-user
STREAMSOUND_SSH_PASSWORD=

# 可选：改用密钥登录时填写私钥路径（填了就不会用密码）
STREAMSOUND_SSH_KEY=

STREAMSOUND_REMOTE_DIR=/home/your-user/streamsound
STREAMSOUND_SERVICE=streamsound
STREAMSOUND_MUSIC_ROOT=/home/your-user/Music
STREAMSOUND_PORT=8080
